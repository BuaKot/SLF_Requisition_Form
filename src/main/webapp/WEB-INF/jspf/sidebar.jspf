<%@ page pageEncoding="UTF-8" %>
<%@ page import="com.slf.util.AuthUtil" %>
<%@ page import="com.slf.util.ThirdPartyAccessPolicy" %>
<%
    String _sidebarPosition = (String) session.getAttribute("position");
    String _sidebarContextPath = request.getContextPath();
    String _sidebarRequestPath = request.getRequestURI();
    if (_sidebarRequestPath != null && _sidebarContextPath != null
            && _sidebarRequestPath.startsWith(_sidebarContextPath)) {
        _sidebarRequestPath = _sidebarRequestPath.substring(_sidebarContextPath.length());
    }
    if (_sidebarRequestPath == null || _sidebarRequestPath.isEmpty()) {
        _sidebarRequestPath = "/";
    }
    String _sidebarPathLower = _sidebarRequestPath.toLowerCase();

    boolean _sidebarIsIndex = "/".equals(_sidebarRequestPath) || "/index.jsp".equalsIgnoreCase(_sidebarRequestPath);
    boolean _sidebarIsProfile = "/emailNotifications".equalsIgnoreCase(_sidebarRequestPath)
        || "/EmailNotificationSettings.jsp".equalsIgnoreCase(_sidebarRequestPath);
    boolean _sidebarIsFormDetail = _sidebarPathLower.contains("it-requisition-form-detail")
        || _sidebarPathLower.contains("third-party-form-detail");
    boolean _sidebarIsRequisitionApprovalDetail = _sidebarPathLower.contains("/requisitiondetail");
    boolean _sidebarIsItFlow = _sidebarPathLower.contains("it-requisition-form-detail")
        || _sidebarPathLower.contains("/itrequisition")
        || _sidebarPathLower.contains("/form.jsp")
        || _sidebarPathLower.contains("/submit")
        || _sidebarPathLower.contains("/history.jsp")
        || _sidebarIsRequisitionApprovalDetail;
    boolean _sidebarIsThirdPartyFlow = _sidebarPathLower.contains("third-party-form-detail")
        || _sidebarPathLower.contains("/thirdparty")
        || _sidebarPathLower.contains("/thirdparty");

    boolean _sidebarShowAdmin = AuthUtil.isAllowedForPage(_sidebarPosition, "adminPage");
    boolean _sidebarShowDashboard = _sidebarPosition != null && _sidebarPosition.trim().equalsIgnoreCase("Admin");
    boolean _sidebarShowOwnThirdPartyLinks = ThirdPartyAccessPolicy.canCreateOwnLinks(
        ThirdPartyAccessPolicy.sessionEmpId(session));
    boolean _sidebarShowThirdPartyHistory = ThirdPartyAccessPolicy.canViewHistory(
        _sidebarPosition, ThirdPartyAccessPolicy.sessionEmpId(session));
    boolean _sidebarApprovalOnlyRole = AuthUtil.isApprovalOnlyRole(_sidebarPosition);
    String _sidebarApprovalPage = AuthUtil.approvalPageForRole(_sidebarPosition);
    String _sidebarApprovalLabel = AuthUtil.approvalLabelForRole(_sidebarPosition);
%>

<div id="mySidebar" class="sidebar" role="navigation" aria-label="Primary navigation">
    <a href="javascript:void(0)" class="closebtn" onclick="toggleNav()" aria-label="Close navigation">&times;</a>
    <a href="${pageContext.request.contextPath}/"><i class="fa-solid fa-house"></i><span>&#3627;&#3609;&#3657;&#3634;&#3627;&#3621;&#3633;&#3585;</span></a>
    <a href="${pageContext.request.contextPath}/emailNotifications"><i class="fa-solid fa-circle-user"></i><span>&#3650;&#3611;&#3619;&#3652;&#3615;&#3621;&#3660;</span></a>

    <% if ((_sidebarIsIndex || _sidebarIsProfile || (_sidebarIsFormDetail && !_sidebarIsItFlow)) 
            && !(_sidebarShowAdmin || _sidebarShowDashboard)) { %>
        <a href="${pageContext.request.contextPath}/logout" class="admin-tab">
            <i class="fa-solid fa-arrow-right-from-bracket"></i><span>&#3629;&#3629;&#3585;&#3592;&#3634;&#3585;&#3619;&#3632;&#3610;&#3610;</span>
        </a>
    <% } else { %>
        <% if (_sidebarApprovalOnlyRole && _sidebarApprovalPage != null) { %>
        <a href="${pageContext.request.contextPath}<%= _sidebarApprovalPage %>" class="approval-menu-link">
            <i class="fa-solid fa-file-signature"></i><span><%= _sidebarApprovalLabel %></span>
        </a>
        <% } else { %>
        <% if (_sidebarIsRequisitionApprovalDetail && AuthUtil.isAllowedForPage(_sidebarPosition, "technicalApprove")) { %>
        <a href="${pageContext.request.contextPath}/technicalApprove" class="approval-menu-link">
            <i class="fa-solid fa-file-signature"></i><span>ความเห็นและการอนุมัติเชิงเทคนิค</span>
        </a>
        <% } %>
        <% if (_sidebarIsRequisitionApprovalDetail && AuthUtil.isAllowedForPage(_sidebarPosition, "process")) { %>
        <a href="${pageContext.request.contextPath}/process" class="approval-menu-link">
            <i class="fa-solid fa-screwdriver-wrench"></i><span>รายการรอดำเนินการ</span>
        </a>
        <% } %>
        <% if (_sidebarIsItFlow) { %>
        <a href="${pageContext.request.contextPath}/submit"><i class="fa-solid fa-paper-plane"></i><span>&#3615;&#3629;&#3619;&#3660;&#3617;&#3607;&#3637;&#3656;&#3626;&#3656;&#3591;&#3649;&#3621;&#3657;&#3623;</span></a>
        <% } %>

        <% if (_sidebarShowOwnThirdPartyLinks && _sidebarIsThirdPartyFlow) { %>
        <a href="${pageContext.request.contextPath}/thirdParty/request/new"><i class="fa-solid fa-link"></i><span>&#3621;&#3636;&#3591;&#3585;&#3660;&#3610;&#3640;&#3588;&#3588;&#3621;&#3616;&#3634;&#3618;&#3609;&#3629;&#3585;</span></a>
        <% if (_sidebarShowThirdPartyHistory) { %>
        <a href="${pageContext.request.contextPath}/thirdParty/history"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติ Third Party</span></a>
        <% } %>
        <% } else if (_sidebarShowOwnThirdPartyLinks && !_sidebarIsItFlow) { %>
        <a href="${pageContext.request.contextPath}/third-party-form-detail.jsp"><i class="fa-solid fa-user-shield"></i><span>Third Party Form</span></a>
        <% } %>
        <% } %>

        <% if (!_sidebarApprovalOnlyRole && (_sidebarShowAdmin || _sidebarShowDashboard)) { %>
        <button id="adminMenuToggle" class="sidebar-menu-toggle" type="button" aria-expanded="false" aria-controls="adminSubMenu" onclick="toggleAdminMenu()">
            <span class="sidebar-menu-label"><i class="fa-solid fa-user-shield"></i><span>&#3648;&#3617;&#3609;&#3641;&#3612;&#3641;&#3657;&#3604;&#3641;&#3649;&#3621;&#3619;&#3632;&#3610;&#3610;</span></span>
            <i class="fa-solid fa-chevron-down sidebar-menu-chevron"></i>
        </button>

        <div id="adminSubMenu" class="sidebar-submenu">
            <% if (_sidebarShowAdmin) { %>
            <a href="${pageContext.request.contextPath}/Admin.jsp"><i class="fa-solid fa-table-cells-large"></i><span>&#3627;&#3609;&#3657;&#3634;&#3592;&#3633;&#3604;&#3585;&#3634;&#3619;&#3619;&#3632;&#3610;&#3610;</span></a>
            <% } %>
            <% if (_sidebarShowDashboard) { %>
            <a href="${pageContext.request.contextPath}/Dashboard.jsp"><i class="fa-solid fa-chart-line"></i><span>&#3649;&#3604;&#3594;&#3610;&#3629;&#3619;&#3660;&#3604;</span></a>
            <a href="${pageContext.request.contextPath}/memberManage"><i class="fa-solid fa-users-gear"></i><span>&#3592;&#3633;&#3604;&#3585;&#3634;&#3619;&#3626;&#3617;&#3634;&#3594;&#3636;&#3585;</span></a>
            <a href="${pageContext.request.contextPath}/mailLog"><i class="fa-solid fa-envelope-open-text"></i><span>&#3610;&#3633;&#3609;&#3607;&#3638;&#3585;&#3585;&#3634;&#3619;&#3626;&#3656;&#3591;&#3629;&#3637;&#3648;&#3617;&#3621;</span></a>
            <a href="${pageContext.request.contextPath}/thirdPartyLinks"><i class="fa-solid fa-link"></i><span>&#3592;&#3633;&#3604;&#3585;&#3634;&#3619;&#3621;&#3636;&#3591;&#3585;&#3660;&#3610;&#3640;&#3588;&#3588;&#3621;&#3616;&#3634;&#3618;&#3609;&#3629;&#3585;</span></a>
            <a href="${pageContext.request.contextPath}/thirdParty/history"><i class="fa-solid fa-clock-rotate-left"></i><span>ประวัติ Third Party</span></a>
            <% } %>
        </div>
        <% } %>

        <a href="${pageContext.request.contextPath}/logout" class="admin-tab">
            <i class="fa-solid fa-arrow-right-from-bracket"></i><span>&#3629;&#3629;&#3585;&#3592;&#3634;&#3585;&#3619;&#3632;&#3610;&#3610;</span>
        </a>
    <% } %>
</div>

<script>
    function toggleAdminMenu() {
        var menu = document.getElementById("adminSubMenu");
        var toggle = document.getElementById("adminMenuToggle");
        if (!menu || !toggle) return;
        var open = menu.classList.toggle("open");
        toggle.classList.toggle("open", open);
        toggle.setAttribute("aria-expanded", String(open));
    }

    (function openCurrentAdminSection() {
        var menu = document.getElementById("adminSubMenu");
        var toggle = document.getElementById("adminMenuToggle");
        if (!menu || !toggle) return;
        var currentPath = window.location.pathname.toLowerCase();
        var isAdminPage = currentPath.indexOf("/admin.jsp") >= 0
            || currentPath.indexOf("/dashboard.jsp") >= 0
            || currentPath.indexOf("/membermanage") >= 0
            || currentPath.indexOf("/maillog") >= 0
            || currentPath.indexOf("/thirdpartylinks") >= 0
            || currentPath.indexOf("/thirdparty/history") >= 0;
        if (isAdminPage) {
            menu.classList.add("open");
            toggle.classList.add("open");
            toggle.setAttribute("aria-expanded", "true");
        }
    }());

    (function syncSidebarMenuButtonState() {
        var sidebar = document.getElementById("mySidebar");
        var menuButton = document.getElementById("menuBtn");
        if (!sidebar || !menuButton) return;

        function updateMenuState() {
            menuButton.setAttribute("aria-expanded", String(sidebar.style.width === "250px"));
        }

        menuButton.addEventListener("click", function () {
            window.setTimeout(updateMenuState, 0);
        });

        var closeButton = sidebar.querySelector(".closebtn");
        if (closeButton) {
            closeButton.addEventListener("click", function () {
                window.setTimeout(updateMenuState, 0);
            });
        }

        updateMenuState();
    }());
</script>
