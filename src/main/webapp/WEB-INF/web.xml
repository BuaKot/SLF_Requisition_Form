<?xml version="1.0" encoding="UTF-8"?>
<!-- zennnne แก้ — อัปเกรดจาก 2.3 → 3.1 เพื่อรองรับ @WebServlet / @WebFilter annotations -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
  <display-name>MyFirstJSP</display-name>

  <servlet>
    <servlet-name>LoadLoginServlet</servlet-name>
    <servlet-class>com.slf.controller.LoadLoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoadLoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>LoadLoginServlet</servlet-name>
    <url-pattern>/login.jsp</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LoginProcessorServlet</servlet-name>
    <servlet-class>com.slf.controller.LoginProcessorServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginProcessorServlet</servlet-name>
    <url-pattern>/processLogin</url-pattern>
  </servlet-mapping>
</web-app>
